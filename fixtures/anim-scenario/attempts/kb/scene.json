{
  "format": "vlmkit-anim/scene@1",
  "kind": "modules",
  "title": "Compiler pipeline",
  "modules": ["lexer", "parser", "typeck", "lower", "codegen", "diagnostics", "symbols"],
  "deps": [
    ["parser", "lexer"],
    ["typeck", "parser"],
    ["typeck", "symbols"],
    ["lower", "typeck"],
    ["lower", "symbols"],
    ["codegen", "lower"],
    ["parser", "diagnostics"],
    ["typeck", "diagnostics"],
    {"from": "codegen", "to": "parser", "style": "forbidden"},
    {"from": "typeck", "to": "symbols", "tone": "accent"}
  ],
  "groups": [
    {"id": "frontend", "label": "frontend", "modules": ["lexer", "parser"]},
    {"id": "middle", "label": "middle", "modules": ["typeck", "lower"]},
    {"id": "backend", "label": "backend", "modules": ["codegen"]},
    {"id": "shared", "label": "shared", "modules": ["diagnostics", "symbols"]}
  ],
  "sequence": [
    {"callout": {"id": "entry", "at": "lexer", "text": "source text enters here", "side": "left"}},
    {"callout": {"id": "exit", "at": "codegen", "text": "machine code leaves here", "side": "right"}},
    {"callout": {"id": "errors", "at": "diagnostics", "text": "every phase may report here; none may read it", "side": "above"}}
  ]
}
