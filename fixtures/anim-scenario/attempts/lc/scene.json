{
  "format": "vlmkit-anim/scene@1",
  "kind": "distributed",
  "title": "Two-phase commit: a lost ack",
  "nodes": [
    {
      "id": "coord",
      "status": "leader"
    },
    "p1",
    "p2"
  ],
  "messages": [
    {
      "from": "coord",
      "to": "p1",
      "label": "prepare"
    },
    {
      "from": "coord",
      "to": "p2",
      "label": "prepare",
      "at": "<"
    },
    {
      "from": "p1",
      "to": "coord",
      "label": "yes"
    },
    {
      "from": "p2",
      "to": "coord",
      "label": "yes"
    },
    {
      "from": "coord",
      "to": "p1",
      "label": "commit"
    },
    {
      "from": "coord",
      "to": "p2",
      "label": "commit",
      "at": "<"
    },
    {
      "from": "p1",
      "to": "coord",
      "label": "ack"
    },
    {
      "from": "p2",
      "to": "coord",
      "label": "ack",
      "lost": true
    },
    {
      "note": "coord times out waiting for p2's ack (lost) and resends the commit"
    },
    {
      "from": "coord",
      "to": "p2",
      "label": "commit again"
    },
    {
      "from": "p2",
      "to": "coord",
      "label": "ack again"
    }
  ],
  "events": [
    {
      "after": "commit again",
      "node": "p2",
      "status": "busy",
      "caption": "p2 applies the resent commit slowly"
    }
  ]
}