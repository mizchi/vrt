{
  "format": "vlmkit-anim/scene@1",
  "kind": "modules",
  "title": "Ports and Adapters",
  "modules": [
    "http",
    "cli",
    "app",
    "domain",
    "port",
    "postgres",
    { "id": "memory", "tone": "muted" }
  ],
  "deps": [
    ["http", "app"],
    ["cli", "app"],
    ["app", "domain"],
    { "from": "app", "to": "port", "tone": "accent" },
    ["port", "domain"],
    { "from": "postgres", "to": "port", "style": "implements" },
    { "from": "memory", "to": "port", "style": "implements" },
    { "from": "domain", "to": "postgres", "style": "forbidden" }
  ],
  "groups": [
    { "id": "driving", "label": "driving", "modules": ["http", "cli"] },
    { "id": "core", "label": "core", "modules": ["app", "domain", "port"] },
    { "id": "adapters", "label": "adapters", "modules": ["postgres", "memory"] }
  ],
  "sequence": [
    { "relate": { "from": "postgres", "to": "memory", "style": "equals", "label": "substitutable" } }
  ]
}
